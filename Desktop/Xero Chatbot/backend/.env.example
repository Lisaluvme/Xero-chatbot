# ==========================================
# GLM-4-FLASH API CREDENTIALS
# ==========================================
# Get your API key from: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# ==========================================
# SQL ACCOUNTING API CONFIGURATION
# ==========================================
# The base URL of your SQL Accounting API server
# This is the server that handles the actual SQL Accounting API calls
# Local development: http://localhost:3001/api
# Production: Your deployed SQL API URL (e.g., Render, Railway, etc.)
SQL_API_BASE_URL=http://localhost:3001/api

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# Render will automatically set PORT environment variable
PORT=3000
NODE_ENV=development

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Add your frontend URL here for production
# Local development: http://localhost:3000
# Production: https://your-frontend.netlify.app
FRONTEND_URL=http://localhost:3000
